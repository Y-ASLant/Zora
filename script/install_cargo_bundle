#!/bin/bash

# Script to install cargo-bundle for CI. This is used as an optimization to speed up CI instead of having to install and
# compile cargo-bundle on each CI workflow run.

# This script should be platform-agnostic (eg. no unix-only references like /dev/null).

set -e

CARGO_BUNDLE_REVISION="ae4c76e92c08774bf54ff077b1c52e3d1cd6c16d"
CACHED_CARGO_BUNDLE_URL="https://storage.googleapis.com/cached_crates/cargo-bundle.zip"

download_cached_cargo_bundle() {
    local attempts=5
    local delay_seconds=5
    local attempt=1

    while test "$attempt" -le "$attempts"; do
        echo "Downloading cached cargo-bundle (attempt $attempt/$attempts)."
        if curl --fail --location --show-error "$CACHED_CARGO_BUNDLE_URL" --output cargo-bundle.zip; then
            return 0
        fi

        if test "$attempt" -lt "$attempts"; then
            echo "Cached cargo-bundle download failed; retrying in $delay_seconds seconds."
            sleep "$delay_seconds"
        fi

        attempt=$((attempt + 1))
    done

    return 1
}

cargo_location=$(dirname "$(which cargo)")
if test -f "$cargo_location/cargo-bundle"; then
    echo "cargo-bundle already exists, not installing."
else
    if download_cached_cargo_bundle; then
        unzip -o cargo-bundle.zip
        chmod 755 cargo-bundle
        cp cargo-bundle "$cargo_location"
        echo "Successfully moved cached cargo-bundle to location $cargo_location"
    else
        echo "Cached cargo-bundle unavailable; compiling pinned cargo-bundle from source."
        cargo install cargo-bundle --git=https://github.com/burtonageo/cargo-bundle --rev "$CARGO_BUNDLE_REVISION"
    fi
fi
